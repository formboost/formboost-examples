---
const endpoint = import.meta.env.PUBLIC_FORMBOOST_ENDPOINT || 'YOUR_FORMBOOST_ENDPOINT';
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Formboost Astro Example</title></head>
  <body>
    <main>
      <h1>Contact us</h1>
      <p>Astro form connected to Formboost.</p>
      <form action={endpoint} method="POST">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input type="email" name="email" autocomplete="email" required /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button type="submit">Send message</button>
      </form>
    </main>
  </body>
</html>
